rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function me(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active(){ return signedIn() && me().data.status == 'active'; }
    function admin(){ return active() && (me().data.role == 'admin' || me().data.role == 'headAdmin'); }
    function headAdmin(){ return active() && me().data.role == 'headAdmin'; }
    function self(uid){ return signedIn() && request.auth.uid == uid; }
    function validStatus(s){ return s == 'speelt' || s == 'reserve' || s == 'afwezig'; }
    function validPair(a,b){
      return (a == 'speelt' && (b == 'reserve' || b == 'afwezig'))
          || (b == 'speelt' && (a == 'reserve' || a == 'afwezig'))
          || (a == 'afwezig' && b == 'afwezig');
    }
    function validCouplePlan(seasonId, coupleId){
      let c = get(/databases/$(database)/documents/seasons/$(seasonId)/couples/$(coupleId));
      return request.resource.data.keys().hasOnly(['coupleId','member1Id','member1Status','member2Id','member2Status','updatedBy','updatedAt'])
          && request.resource.data.coupleId == coupleId
          && request.resource.data.member1Id == c.data.memberIds[0]
          && request.resource.data.member2Id == c.data.memberIds[1]
          && validStatus(request.resource.data.member1Status)
          && validStatus(request.resource.data.member2Status)
          && validPair(request.resource.data.member1Status, request.resource.data.member2Status)
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
    }
    function ownCoupleBeforeClose(seasonId, playDateId, coupleId){
      return active()
          && me().data.coupleId == coupleId
          && get(/databases/$(database)/documents/seasons/$(seasonId)/playDates/$(playDateId)).data.status == 'active'
          && get(/databases/$(database)/documents/seasons/$(seasonId)/playDates/$(playDateId)).data.closeAt is timestamp
          && request.time < get(/databases/$(database)/documents/seasons/$(seasonId)/playDates/$(playDateId)).data.closeAt;
    }
    function validSubstituteProposal(seasonId, playDateId, coupleId){
      return ownCoupleBeforeClose(seasonId, playDateId, coupleId)
          && resource.data.member1Status == 'afwezig'
          && resource.data.member2Status == 'afwezig'
          && request.resource.data.member1Status == 'afwezig'
          && request.resource.data.member2Status == 'afwezig'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'substituteId','substituteName','substituteType','substituteApproval',
            'substituteSubmittedBy','substituteSubmittedAt','updatedAt'
          ])
          && request.resource.data.substituteName is string
          && request.resource.data.substituteName.size() > 1
          && (request.resource.data.substituteType == 'reserve' || request.resource.data.substituteType == 'external')
          && request.resource.data.substituteApproval == 'pending'
          && request.resource.data.substituteSubmittedBy == request.auth.uid
          && request.resource.data.substituteSubmittedAt == request.time
          && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if self(uid) || admin();
      allow update: if
        (self(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone','singlesAllowed','updatedAt']))
        || (headAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coupleId','participantType','playerId','reserveId','updatedAt']))
        || (headAdmin() && !self(uid) && resource.data.role != 'headAdmin'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && (request.resource.data.role == 'admin' || request.resource.data.role == 'player'));
      allow create: if self(uid)
        && request.resource.data.keys().hasOnly(['email','role','status','participantType','createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'player'
        && request.resource.data.status == 'pending'
        && request.resource.data.participantType == 'pending';
      allow update: if headAdmin() && !self(uid) && resource.data.status == 'pending'
        && request.resource.data.status == 'active'
        && request.resource.data.role == 'player'
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    match /seasons/{seasonId} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if headAdmin();

      match /players/{playerId} {
        allow read, create, update: if admin();
        allow delete: if headAdmin();
      }
      match /reserves/{reserveId} {
        allow read, create, update: if admin();
        allow delete: if headAdmin();
      }
      match /couples/{coupleId} {
        allow read: if active();
        allow create, update: if admin();
        allow delete: if headAdmin();
      }
      match /public/{docId} {
        allow read: if active();
        allow create, update: if admin();
        allow delete: if headAdmin();
      }

      match /playDates/{playDateId} {
        allow read: if active();
        allow create, update: if admin();
        allow delete: if headAdmin();

        match /couplePlans/{coupleId} {
          allow read: if active();
          allow create: if admin() || (
            ownCoupleBeforeClose(seasonId, playDateId, coupleId)
            && validCouplePlan(seasonId, coupleId)
          );
          allow update: if admin() || (
            ownCoupleBeforeClose(seasonId, playDateId, coupleId)
            && validCouplePlan(seasonId, coupleId)
          ) || validSubstituteProposal(seasonId, playDateId, coupleId);
          allow delete: if headAdmin();
        }
        match /public/{docId} { allow read: if active(); allow write: if admin(); }
        match /results/{resultId} {
          allow read: if active();
          allow create, update: if admin() || (
            active()
            && me().data.participantType == 'fixed'
            && (request.resource.data.coupleAId == me().data.coupleId || request.resource.data.coupleBId == me().data.coupleId)
            && request.resource.data.enteredBy == request.auth.uid
            && get(/databases/$(database)/documents/seasons/$(seasonId)/playDates/$(playDateId)/public/lineup).data.published == true
            && request.resource.data.keys().hasOnly(['courtNumber','mode','coupleAId','coupleAName','coupleBId','coupleBName','scoreText','pointsA','pointsB','sets','lastGamePoints','unfinishedLastSet','unfinishedGamePoints','note','enteredBy','enteredAt'])
          );
          allow delete: if admin();
        }
      }
      match /standings/{coupleId} { allow read: if active(); allow write: if admin(); }
      match /payments/{paymentId} { allow read, create, update: if admin(); allow delete: if headAdmin(); }
    }
    match /auditLogs/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
